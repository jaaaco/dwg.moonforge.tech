<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lifeos.dwg-content-gen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/jaaaco/projects/dwg.moonforge.tech/automation/content-gen.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jaaaco/projects/dwg.moonforge.tech</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/Users/jaaaco/.local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/jaaaco</string>
    </dict>

    <!-- Tuesday and Friday 07:53: Polish page, then its English counterpart. Different days from the PDF site's generator (Mon+Thu), so two claude -p runs never overlap. Loaded on 2026-10-13, after the first inbound links; until then this file exists but is not bootstrapped. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>53</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>53</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jaaaco/projects/dwg.moonforge.tech/automation/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaaaco/projects/dwg.moonforge.tech/automation/logs/launchd.log</string>
</dict>
</plist>
