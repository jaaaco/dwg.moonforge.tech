<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lifeos.dwg-deploy-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/jaaaco/projects/dwg.moonforge.tech/automation/deploy-watch.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jaaaco/projects/dwg.moonforge.tech</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/Users/jaaaco/.local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/jaaaco</string>
    </dict>

    <!-- Daily 08:51. Silent while healthy. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>51</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jaaaco/projects/dwg.moonforge.tech/automation/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaaaco/projects/dwg.moonforge.tech/automation/logs/launchd.log</string>
</dict>
</plist>
