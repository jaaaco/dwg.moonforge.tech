/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Engine assets sit under a content-hashed directory (scripts/prepare-cad.mjs),
# so they can be cached like build output: a change ships a new path.
/cad/*
  Cache-Control: public, max-age=31536000, immutable

# 'unsafe-eval' above is for the DWG parser only: it is Emscripten output and
# evaluates generated code. Chromium honours a narrower policy served with the
# worker script itself, but WebKit also applies the document's policy to its
# workers, so Safari needs it on the page. Everything else stays strict: no
# third-party origin is allowed to load anything, and nothing from a drawing is
# ever inserted as HTML (text is drawn on the canvas, layer names go through
# createTextNode).

/samples/*
  Cache-Control: public, max-age=3600
