const checked = '2026-09-17'
const sources = [
  ['Autodesk: Buy AutoCAD', 'https://www.autodesk.com/products/autocad/buy'],
  ['Autodesk: Buy AutoCAD LT', 'https://www.autodesk.com/products/autocad-lt/buy'],
  ['Autodesk support: Can I buy a stand-alone (perpetual) license?', 'https://www.autodesk.com/support/technical/article/caas/sfdcarticles/sfdcarticles/Can-I-buy-a-stand-alone-perpetual-license.html'],
  ['Autodesk: DWG TrueView overview', 'https://www.autodesk.com/products/dwg-trueview/overview'],
  ['Autodesk support: DWG TrueView will not install on the Mac operating system', 'https://www.autodesk.com/support/technical/article/caas/sfdcarticles/sfdcarticles/DWG-TrueView-will-not-install-on-the-Mac-operating-system-to-open-DWG-files.html'],
  ['Autodesk support: System Requirements for Autodesk DWG TrueView 2027', 'https://www.autodesk.com/support/technical/article/caas/sfdcarticles/sfdcarticles/System-Requirements-for-Autodesk-DWG-TrueView-2027.html'],
  ['Autodesk Viewer help: Getting started', 'https://help.autodesk.com/cloudhelp/ENU/ADSKVIEWER-Help/files/ADSKVIEWER_Help_GettingStarted_html.html'],
  ['Autodesk support: Is it possible to extend the 30-day period of your design view uploaded to Autodesk Viewer?', 'https://www.autodesk.com/support/technical/article/caas/sfdcarticles/sfdcarticles/Are-files-uploaded-to-the-Autodesk-Viewer-deleted-after-30-days-or-can-this-period-be-extended.html'],
  ['Autodesk support: How does Autodesk Viewer store data?', 'https://www.autodesk.com/support/technical/article/caas/sfdcarticles/sfdcarticles/Where-does-Autodesk-Viewer-keep-the-data.html'],
  ['Open Design Alliance: Open Design Specification for .dwg files', 'https://www.opendesign.com/files/guestdownloads/OpenDesign_Specification_for_.dwg_files.pdf'],
