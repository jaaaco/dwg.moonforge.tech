---
import { ui, type Locale } from '../lib/i18n'

interface Props { locale: Locale }
const { locale } = Astro.props
const t = ui[locale]
---
<section id="viewer" class="viewer" data-state="empty" data-strings={JSON.stringify(t)}>
  <div class="viewer-bar">
    <label class="btn btn-primary viewer-open">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h4l1.5 1.5H14V13H2z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      <span>{t.vOpen}</span>
      <input type="file" accept=".dwg,.dxf" hidden data-role="file" />
    </label>
    <span class="viewer-status" data-role="status" role="status" aria-live="polite"></span>
    <span class="viewer-badge" title={t.vDropHint}>● {t.vPrivacyBadge}</span>
    <div class="viewer-actions" data-role="actions" hidden>
      <button class="btn btn-ghost" type="button" data-role="fit">{t.vFit}</button>
      <button class="btn btn-ghost" type="button" data-role="measure-toggle" aria-expanded="false">{t.mMeasure}</button>
      <button class="btn btn-ghost" type="button" data-role="plot-toggle" aria-expanded="false">{t.pExport}</button>
      <button class="btn btn-ghost" type="button" data-role="layers-toggle" aria-expanded="false">{t.vLayers}</button>
      <button class="btn btn-ghost" type="button" data-role="close" aria-label={t.vClose}>✕</button>
    </div>
  </div>
  <div class="viewer-body">
    <div class="viewer-canvas" data-role="canvas"></div>
    <div class="viewer-empty" data-role="empty">
      <p class="viewer-drop">{t.vDrop}</p>
      <p class="muted">{t.vDropHint}</p>
      <button class="btn btn-ghost" type="button" data-role="sample">{t.vSample}</button>
    </div>
    <aside class="viewer-layers" data-role="layers" hidden>
      <div class="viewer-layers-head">
        <strong>{t.vLayers}</strong>
        <button type="button" class="link" data-role="layers-all">{t.vAllOn}</button>
      </div>
      <ul data-role="layer-list"></ul>
    </aside>
    <aside class="viewer-plot" data-role="plot" hidden>
      <div class="viewer-layers-head">
        <strong>{t.pTitle}</strong>
        <button type="button" class="link" data-role="plot-close" aria-label={t.pClose}>✕</button>
      </div>
      <div class="plot-preview"><canvas data-role="plot-canvas" width="240" height="340"></canvas></div>
      <p class="plot-note" data-role="plot-note" role="status" aria-live="polite"></p>
      <label>{t.pArea}
        <select data-role="plot-area">
          <option value="all">{t.pAreaAll}</option>
          <option value="view">{t.pAreaView}</option>
          <option value="window">{t.pAreaWindow}</option>
        </select>
      </label>
      <button type="button" class="btn btn-ghost plot-window" data-role="plot-window">{t.pPickWindow}</button>
      <label>{t.pPaper}
        <select data-role="plot-paper">
          <option value="A4">A4</option>
          <option value="A3" selected>A3</option>
          <option value="A2">A2</option>
          <option value="A1">A1</option>
          <option value="A0">A0</option>
          <option value="letter">Letter</option>
        </select>
      </label>
      <label>{t.pOrientation}
        <select data-role="plot-orientation">
          <option value="auto">{t.pAuto}</option>
          <option value="landscape">{t.pLandscape}</option>
          <option value="portrait">{t.pPortrait}</option>
        </select>
      </label>
      <label>{t.pScale}
        <select data-role="plot-scale">
          <option value="fit">{t.pFit}</option>
          <option value="1">1:1</option>
          <option value="2">1:2</option>
          <option value="5">1:5</option>
          <option value="10">1:10</option>
          <option value="20">1:20</option>
          <option value="25">1:25</option>
          <option value="50">1:50</option>
          <option value="100">1:100</option>
          <option value="200">1:200</option>
          <option value="500">1:500</option>
          <option value="1000">1:1000</option>
        </select>
      </label>
      <label>{t.pColors}
        <select data-role="plot-colors">
          <option value="mono">{t.pMono}</option>
          <option value="colors">{t.pAsShown}</option>
        </select>
      </label>
      <label>{t.pLineWidth}
        <select data-role="plot-width">
          <option value="0.13">0,13 mm</option>
          <option value="0.2" selected>0,20 mm</option>
          <option value="0.35">0,35 mm</option>
        </select>
      </label>
      <button class="btn btn-primary plot-save" type="button" data-role="plot-save" disabled>{t.pSave}</button>
    </aside>
    <canvas class="viewer-measure" data-role="measure-canvas" hidden></canvas>
    <aside class="viewer-measure-box" data-role="measure" hidden>
      <div class="measure-head">
        <strong>{t.mTitle}</strong>
        <button type="button" class="link" data-role="measure-clear">{t.mClear}</button>
        <button type="button" class="link" data-role="measure-close" aria-label={t.mClose}>✕</button>
      </div>
      <div class="measure-readout" data-role="measure-readout" role="status" aria-live="polite"></div>
      <label class="measure-units">{t.mUnits}
        <select data-role="measure-units"></select>
      </label>
      <p class="measure-hint" data-role="measure-hint"></p>
    </aside>
    <div class="viewer-pick" data-role="pick" hidden><div class="viewer-pick-rect" data-role="pick-rect" hidden></div></div>
    <div class="viewer-dropzone" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { mountViewer } from '../viewer/app'
  const root = document.getElementById('viewer')
  if (root) mountViewer(root)
</script>

<style>
  .viewer {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .viewer-bar {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    padding: 0.6rem; border-bottom: 1px solid var(--line);
  }
  .viewer-open { cursor: pointer; }
  .viewer-status { font-size: 0.9rem; color: var(--text-muted); min-width: 0; overflow-wrap: anywhere; }
  .viewer-badge { font-size: 0.8rem; color: #2f9e5a; margin-left: auto; white-space: nowrap; }
  .viewer-actions { display: flex; gap: 0.4rem; }
  .viewer-actions .btn { padding: 0.55rem 0.8rem; }
  .viewer[data-state='open'] .viewer-badge { margin-left: 0; }
  .viewer[data-state='open'] .viewer-actions { margin-left: auto; }

  .viewer-body {
    /* The drawing area stays dark in both themes, like model space in any CAD
       program: layer colours are chosen for a dark ground. */
    --vb-bg: #0c0c0e; --vb-line: #1d1d22; --vb-text: #e2e2e6; --vb-muted: #9a9aa3;
    position: relative; height: min(72vh, 720px); min-height: 360px;
    background: var(--vb-bg); color: var(--vb-text);
  }
  .viewer-canvas { position: absolute; inset: 0; }
  .viewer-canvas :global(canvas) { display: block; touch-action: none; }
  /* The engine ships editing chrome (command line, undo/erase toolbar, mobile
     command panel). This is a viewer, so it stays hidden. */
  .viewer-canvas :global(.ml-cli-container),
  .viewer-canvas :global(.ml-mobile-cmd),
  .viewer-canvas :global(.ml-desktop-session-accessory),
  .viewer-canvas :global(.ml-ui-shortcut-toolbar-shell) { display: none !important; }

  .viewer-empty {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center; gap: 0.3rem; padding: 1rem;
    background-image:
      linear-gradient(var(--vb-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--vb-line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center;
  }
  .viewer-empty > * { background: var(--vb-bg); padding: 0.1rem 0.5rem; margin: 0; }
  .viewer-empty .muted { color: var(--vb-muted); }
  .viewer-empty .btn-ghost { color: var(--vb-text); border-color: #3a3a42; }
  .viewer-empty .btn { margin-top: 0.7rem; }
  .viewer-drop { font: 500 1.4rem var(--font-display); }
  .viewer[data-state='open'] .viewer-empty,
  .viewer[data-state='loading'] .viewer-empty { display: none; }

  .viewer-layers {
    position: absolute; top: 0; right: 0; bottom: 0; width: min(18rem, 85%);
    background: var(--bg-raised); border-left: 1px solid var(--line);
    overflow: auto; padding: 0.6rem 0.8rem; font-size: 0.88rem;
  }
  .viewer-layers-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
  .viewer-layers ul { list-style: none; margin: 0; padding: 0; }
  .viewer-layers :global(li) { display: flex; align-items: center; gap: 0.45rem; padding: 0.2rem 0; }
  .viewer-layers :global(li label) { display: flex; align-items: center; gap: 0.45rem; cursor: pointer; overflow-wrap: anywhere; }
  .viewer-layers :global(.swatch) { width: 10px; height: 10px; border: 1px solid var(--line); flex: none; }
  .link { background: none; border: 0; color: var(--accent); cursor: pointer; font: inherit; padding: 0; }

  .viewer-dropzone { position: absolute; inset: 8px; border: 3px dashed var(--accent); border-radius: var(--radius); display: none; pointer-events: none; }
  .viewer[data-drag='1'] .viewer-dropzone { display: block; }

  .viewer-plot {
    position: absolute; top: 0; right: 0; bottom: 0; width: min(19rem, 92%);
    background: var(--bg-raised); border-left: 1px solid var(--line);
    overflow: auto; padding: 0.6rem 0.8rem 1rem; font-size: 0.88rem;
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .viewer-plot[hidden] { display: none; }
  /* The panel scrolls; nothing in it may be squeezed, or the preview canvas
     (which keeps its own pixel size) spills out of its box. */
  .viewer-plot > * { flex: none; }
  .viewer-plot :global(label) { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem; }
  .viewer-plot :global(select) {
    font: inherit; padding: 0.3rem 0.4rem; background: var(--bg); color: inherit;
    border: 1px solid var(--line); border-radius: 6px; max-width: 11rem;
  }
  .plot-preview {
    display: flex; justify-content: center; align-items: center;
    background: #15151a; border: 1px solid var(--line); border-radius: 6px; padding: 0.5rem; min-height: 8rem;
  }
  /* The canvas carries its own size, set from the sheet's aspect. */
  .plot-preview :global(canvas) { max-width: 100%; box-shadow: 0 1px 6px rgb(0 0 0 / 0.4); }
  .plot-note { margin: 0; color: var(--text-muted); font-size: 0.82rem; }
  .plot-window { width: 100%; }
  .plot-save { margin-top: 0.2rem; }

  /* Measuring paints over the drawing but never takes a pointer event: panning
     and zooming have to keep working while a measurement is open. */
  .viewer-measure { position: absolute; inset: 0; pointer-events: none; }
  .viewer-measure[hidden] { display: none; }
  .viewer[data-measure='1'] .viewer-canvas { cursor: crosshair; }
  .viewer-measure-box {
    position: absolute; left: 0.6rem; bottom: 0.6rem; width: min(17rem, calc(100% - 1.2rem));
    background: var(--bg-raised); border: 1px solid var(--line); border-radius: 8px;
    padding: 0.5rem 0.6rem; font-size: 0.85rem; box-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
  }
  .viewer-measure-box[hidden] { display: none; }
  .measure-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.25rem; }
  .measure-head strong { margin-right: auto; }
  .measure-readout { display: grid; gap: 0.1rem; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .measure-readout :global(.measure-main) { font: 600 1.05rem/1.3 var(--font-display); }
  .measure-units { display: flex; align-items: center; gap: 0.4rem; margin-top: 0.45rem; color: var(--text-muted); font-size: 0.78rem; }
  .measure-units :global(select) {
    font: inherit; padding: 0.15rem 0.3rem; background: var(--bg); color: var(--text);
    border: 1px solid var(--line); border-radius: 5px; flex: 1; min-width: 0;
  }
  .measure-hint { margin: 0.35rem 0 0; color: var(--text-muted); font-size: 0.75rem; }
  /* Same green as the snap marker on the drawing: the readout and the marker
     are saying the same thing. */
  .measure-hint :global(.measure-snap) { color: #5ee08a; }

  /* Window picking sits above the canvas so the drawing never sees the drag. */
  .viewer-pick { position: absolute; inset: 0; cursor: crosshair; background: rgb(0 0 0 / 0.25); }
  .viewer-pick[hidden] { display: none; }
  .viewer-pick-rect { position: absolute; border: 1px solid var(--accent); background: rgb(255 255 255 / 0.12); }

  @media (max-width: 640px) {
    .viewer-body { height: 64vh; }
    .viewer-badge { display: none; }
  }
</style>
